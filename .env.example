# Optional Supabase sync. Leave blank to play local-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Laptop only, for `npx tsx scripts/gauntlet-results.ts` (reads horde gauntlet
# results). The service_role key from Supabase (Project Settings → API keys).
# It bypasses row-level security: put it in .env.local, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
