{
  "name": "kanji-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:slow": "SLOW=1 vitest run",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo",
    "test:watch": "vitest",
    "lint": "eslint --cache . && prettier --check --cache .",
    "format": "prettier --write .",
    "check:fast": "files=$(git diff --name-only --diff-filter=d HEAD -- '*.ts'; git ls-files -o --exclude-standard -- '*.ts') && { [ -z \"$files\" ] || vitest related --run $files; } && npm run typecheck && npm run lint",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "data:build": "tsx scripts/build-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "three": "0.186.1"
  }
}
